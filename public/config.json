{
  "port": "9000",
  "backgroundImage": "/assets/background.jpg",
  "apps": [
    {
     "name": "Jellyfin",
     "cliCommand": "flatpak run org.jellyfin.JellyfinDesktop --fullscreen",
     "image": "/assets/apps/jellyfin.png",
     "backgroundImage": "/assets/apps/backgrounds/jellyfin_background.png"
    },
    {
      "name": "youtube",
      "cliCommand": "flatpak run rocks.shy.VacuumTube --fullscreen",
      "image": "/assets/apps/youtube.png",
      "backgroundImage": "/assets/apps/backgrounds/youtube_background.png"
    },
    {
      "name": "stremio",
      "cliCommand": "flatpak run com.stremio.Stremio",
      "image": "/assets/apps/stremio.png",
      "backgroundImage": "/assets/apps/backgrounds/stremio_background.png"
    },
    {
      "name": "Twitch",
      "cliCommand": "flatpak run org.mozilla.firefox --no-remote -P kiosk --kiosk https://twitch.com",
      "image": "/assets/apps/twitch.png",
      "backgroundImage": "/assets/apps/backgrounds/twitch_background.png"

    },
    {
      "name": "steam",
      "cliCommand": "steam -gamepadui",
      "image": "/assets/apps/steam.png",
      "backgroundImage": "/assets/apps/backgrounds/steam_background.png"
    },
    {
      "name": "retroarch",
      "cliCommand": "flatpak run org.libretro.RetroArch",
      "image": "/assets/apps/retroarch.png",
      "backgroundImage": "/assets/apps/backgrounds/retroarch_background.png"
    }
  ],
  "lockCommand": "loginctl lock-session",
  "shutDownCommand": ""
}
